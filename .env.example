# ==============================================================================
# SecureWeb Environment Configuration Template
# Copy this file to '.env' and populate with your production or local secrets.
# DO NOT commit real secrets or production .env files to version control!
# ==============================================================================

# Application Environment (development, testing, production)
FLASK_ENV=development
FLASK_DEBUG=1

# Secret Key for cryptographic session signing and CSRF tokens
# Generate a strong key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production-min-32-chars

# Database Configuration (SQLite default for local dev)
DATABASE_URL=sqlite:///instance/secureweb.db

# Security Settings
# In production, set SESSION_COOKIE_SECURE to True (requires HTTPS)
SESSION_COOKIE_SECURE=False

# Rate Limiting Storage (memory:// or redis://localhost:6379/0)
RATELIMIT_STORAGE_URI=memory://
